        <movies:fullName>Anthony Perkins</movies:fullName>
        <movies:nationality>American</movies:nationality>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/movies#Avatar_2009 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/movies#Avatar_2009">
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#AcclaimedMovie"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#SciFiMovie"/>
        <movies:belongsToGenre rdf:resource="http://www.semanticweb.org/movies#Genre_SciFi"/>
        <movies:hasActor rdf:resource="http://www.semanticweb.org/movies#SamWorthington"/>
        <movies:hasActor rdf:resource="http://www.semanticweb.org/movies#SigourneyWeaver"/>
        <movies:hasActor rdf:resource="http://www.semanticweb.org/movies#ZoeSaldana"/>
        <movies:hasCastMember rdf:resource="http://www.semanticweb.org/movies#JamesCameron"/>
        <movies:hasCastMember rdf:resource="http://www.semanticweb.org/movies#SamWorthington"/>
        <movies:hasCastMember rdf:resource="http://www.semanticweb.org/movies#SigourneyWeaver"/>
        <movies:hasCastMember rdf:resource="http://www.semanticweb.org/movies#ZoeSaldana"/>
        <movies:hasDirector rdf:resource="http://www.semanticweb.org/movies#JamesCameron"/>
