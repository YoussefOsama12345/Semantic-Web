    <!-- http://www.semanticweb.org/movies#AnthonyHopkins -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/movies#AnthonyHopkins">
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#Actor"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#Person"/>
        <movies:actedIn rdf:resource="http://www.semanticweb.org/movies#TheSilenceOfTheLambs_1991"/>
        <movies:birthYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1937</movies:birthYear>
