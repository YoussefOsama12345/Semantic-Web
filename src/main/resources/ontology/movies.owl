<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/osama/ontologies/2026/3/untitled-ontology-5#"
     xml:base="http://www.semanticweb.org/osama/ontologies/2026/3/untitled-ontology-5"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:movies="http://www.semanticweb.org/movies#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/osama/ontologies/2026/3/untitled-ontology-5">
        <rdfs:comment>Semantic Movie Recommendation Ontology</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/movies#actedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#actedIn">
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/movies#hasCastMember"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/movies#hasActor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#belongsToGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#belongsToGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Genre"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#directed -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#directed">
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/movies#hasCastMember"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/movies#hasDirector"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Director"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#frequentCollaborator -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#frequentCollaborator">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#hasActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#hasActor">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/movies#hasCastMember"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#hasCastMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#hasCastMember">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#hasDirector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#hasDirector">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/movies#hasCastMember"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Director"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#hasWriter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#hasWriter">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/movies#hasCastMember"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Writer"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#producedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#producedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#ProductionCompany"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#producedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#producedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#similarTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#similarTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/movies#similarTo"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/movies#wonAward -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/movies#wonAward">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/movies#Award"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/movies#birthYear -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#birthYear">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/movies#duration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#duration">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/movies#fullName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#fullName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/movies#imdbRating -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#imdbRating">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/movies#nationality -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#nationality">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/movies#plot -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#plot">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/movies#releaseYear -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#releaseYear">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/movies#title -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/movies#title">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/movies#Movie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/movies#AcclaimedMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#AcclaimedMovie">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/movies#Movie"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/movies#wonAward"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/movies#OscarAward"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#ActionMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#ActionMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#Actor -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Actor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#AnimationMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#AnimationMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#Award -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Award"/>
    


    <!-- http://www.semanticweb.org/movies#CannesAward -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#CannesAward">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Award"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#ClassicMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#ClassicMovie">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/movies#Movie"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/movies#releaseYear"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1980</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#ComedyMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#ComedyMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#Country -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Country"/>
    


    <!-- http://www.semanticweb.org/movies#Director -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Director">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#DramaMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#DramaMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#Genre -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Genre"/>
    


    <!-- http://www.semanticweb.org/movies#GoldenGlobeAward -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#GoldenGlobeAward">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Award"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#HorrorMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#HorrorMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#MasterpieceMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#MasterpieceMovie">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/movies#Movie"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/movies#wonAward"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/movies#Award"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/movies#imdbRating"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#double">8.5</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#Movie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Movie">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/movies#hasDirector"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/movies#Director"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#OscarAward -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#OscarAward">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Award"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Person"/>
    


    <!-- http://www.semanticweb.org/movies#Producer -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Producer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#ProductionCompany -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#ProductionCompany"/>
    


    <!-- http://www.semanticweb.org/movies#RomanceMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#RomanceMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#SciFiMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#SciFiMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#ThrillerMovie -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#ThrillerMovie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Movie"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/movies#Writer -->

    <owl:Class rdf:about="http://www.semanticweb.org/movies#Writer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/movies#Person"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/movies#AaronEckhart -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/movies#AaronEckhart">
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#Actor"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#Person"/>
        <movies:actedIn rdf:resource="http://www.semanticweb.org/movies#TheDarkKnight_2008"/>
        <movies:birthYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1968</movies:birthYear>
        <movies:fullName>Aaron Eckhart</movies:fullName>
        <movies:nationality>American</movies:nationality>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/movies#AlPacino -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/movies#AlPacino">
