    <!-- http://www.semanticweb.org/movies#AnthonyPerkins -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/movies#AnthonyPerkins">
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#Actor"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/movies#Person"/>
        <movies:actedIn rdf:resource="http://www.semanticweb.org/movies#Psycho_1960"/>
