mov:Inception_2010 a mov:SciFiMovie ;
    mov:title "Inception" ; mov:releaseYear 2010 ; mov:duration 148 ; mov:imdbRating "8.8"^^xsd:double ;
    mov:plot "A thief who steals corporate secrets through dream-sharing technology." ;
    mov:hasDirector mov:ChristopherNolan ;
    mov:hasActor mov:LeonardoDiCaprio , mov:JosephGordonLevitt , mov:EllenPage , mov:TomHardy ;
    mov:belongsToGenre mov:Genre_SciFi ;
    mov:wonAward mov:Oscar_Inception .

mov:TheGodfather_1972 a mov:DramaMovie ;
    mov:title "The Godfather" ; mov:releaseYear 1972 ; mov:duration 175 ; mov:imdbRating "9.2"^^xsd:double ;
    mov:plot "The aging patriarch of an organized crime dynasty transfers control to his son." ;
    mov:hasDirector mov:FrancisFordCoppola ;
    mov:hasActor mov:MarlonBrando , mov:AlPacino , mov:JamesCaan ;
    mov:belongsToGenre mov:Genre_Drama ;
    mov:wonAward mov:Oscar_Godfather .

mov:PulpFiction_1994 a mov:ThrillerMovie ;
    mov:title "Pulp Fiction" ; mov:releaseYear 1994 ; mov:duration 154 ; mov:imdbRating "8.9"^^xsd:double ;
    mov:plot "Interwoven stories of crime in Los Angeles." ;
    mov:hasDirector mov:QuentinTarantino ;
    mov:hasActor mov:JohnTravolta , mov:SamuelLJackson , mov:UmaThurman , mov:BruceWillis ;
    mov:belongsToGenre mov:Genre_Thriller ;
    mov:wonAward mov:Oscar_PulpFiction , mov:Cannes_PulpFiction .

mov:TheDarkKnight_2008 a mov:ActionMovie ;
    mov:title "The Dark Knight" ; mov:releaseYear 2008 ; mov:duration 152 ; mov:imdbRating "9.0"^^xsd:double ;
    mov:plot "Batman fights the menace known as the Joker." ;
    mov:hasDirector mov:ChristopherNolan ;
    mov:hasActor mov:ChristianBale , mov:HeathLedger , mov:AaronEckhart ;
    mov:belongsToGenre mov:Genre_Action ;
    mov:wonAward mov:Oscar_DarkKnight .

mov:Interstellar_2014 a mov:SciFiMovie ;
    mov:title "Interstellar" ; mov:releaseYear 2014 ; mov:duration 169 ; mov:imdbRating "8.6"^^xsd:double ;
    mov:plot "A team of explorers travel through a wormhole in space." ;
    mov:hasDirector mov:ChristopherNolan ;
    mov:hasActor mov:MatthewMcConaughey , mov:AnneHathaway , mov:JessicaChastain ;
    mov:belongsToGenre mov:Genre_SciFi ;
    mov:wonAward mov:Oscar_Interstellar .

mov:Parasite_2019 a mov:ThrillerMovie ;
    mov:title "Parasite" ; mov:releaseYear 2019 ; mov:duration 132 ; mov:imdbRating "8.5"^^xsd:double ;
    mov:plot "A poor family schemes to become employed by a wealthy family." ;
    mov:hasDirector mov:BongJoonHo ;
    mov:hasActor mov:SongKangHo , mov:LeeSunKyun , mov:ChoYeoJeong ;
