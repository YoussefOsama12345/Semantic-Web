@prefix : <http://www.semanticweb.org/movies#> .
@prefix mov: <http://www.semanticweb.org/movies#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .

<http://www.semanticweb.org/movies> a owl:Ontology ;
    rdfs:comment "Semantic Movie Recommendation Ontology" .

mov:Movie a owl:Class .
mov:ActionMovie    a owl:Class ; rdfs:subClassOf mov:Movie .
mov:DramaMovie     a owl:Class ; rdfs:subClassOf mov:Movie .
mov:ComedyMovie    a owl:Class ; rdfs:subClassOf mov:Movie .
mov:ThrillerMovie  a owl:Class ; rdfs:subClassOf mov:Movie .
mov:SciFiMovie     a owl:Class ; rdfs:subClassOf mov:Movie .
mov:HorrorMovie    a owl:Class ; rdfs:subClassOf mov:Movie .
mov:RomanceMovie   a owl:Class ; rdfs:subClassOf mov:Movie .
mov:AnimationMovie a owl:Class ; rdfs:subClassOf mov:Movie .

mov:Person   a owl:Class .
mov:Actor    a owl:Class ; rdfs:subClassOf mov:Person .
mov:Director a owl:Class ; rdfs:subClassOf mov:Person .
mov:Writer   a owl:Class ; rdfs:subClassOf mov:Person .
mov:Producer a owl:Class ; rdfs:subClassOf mov:Person .

mov:Genre              a owl:Class .
mov:Award              a owl:Class .
mov:OscarAward         a owl:Class ; rdfs:subClassOf mov:Award .
mov:GoldenGlobeAward   a owl:Class ; rdfs:subClassOf mov:Award .
mov:CannesAward        a owl:Class ; rdfs:subClassOf mov:Award .
mov:ProductionCompany  a owl:Class .
mov:Country            a owl:Class .

mov:hasCastMember a owl:ObjectProperty ;
    rdfs:domain mov:Movie ; rdfs:range mov:Person .

mov:hasActor a owl:ObjectProperty ;
    rdfs:subPropertyOf mov:hasCastMember ;
    rdfs:domain mov:Movie ; rdfs:range mov:Actor .

mov:hasDirector a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf mov:hasCastMember ;
    rdfs:domain mov:Movie ; rdfs:range mov:Director .

mov:hasWriter a owl:ObjectProperty ;
    rdfs:subPropertyOf mov:hasCastMember ;
    rdfs:domain mov:Movie ; rdfs:range mov:Writer .

mov:belongsToGenre a owl:ObjectProperty ;
    rdfs:domain mov:Movie ; rdfs:range mov:Genre .

mov:wonAward a owl:ObjectProperty ;
    rdfs:domain mov:Movie ; rdfs:range mov:Award .

mov:producedBy a owl:ObjectProperty ;
    rdfs:domain mov:Movie ; rdfs:range mov:ProductionCompany .

mov:producedIn a owl:ObjectProperty ;
    rdfs:domain mov:Movie ; rdfs:range mov:Country .

mov:similarTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain mov:Movie ; rdfs:range mov:Movie .

mov:actedIn a owl:ObjectProperty ;
    owl:inverseOf mov:hasActor ;
    rdfs:domain mov:Actor ; rdfs:range mov:Movie .

mov:directed a owl:ObjectProperty ;
    owl:inverseOf mov:hasDirector ;
    rdfs:domain mov:Director ; rdfs:range mov:Movie .

mov:frequentCollaborator a owl:ObjectProperty ;
    rdfs:domain mov:Person ; rdfs:range mov:Person .

mov:title       a owl:DatatypeProperty ; rdfs:domain mov:Movie  ; rdfs:range xsd:string .
mov:releaseYear a owl:DatatypeProperty ; rdfs:domain mov:Movie  ; rdfs:range xsd:int .
mov:duration    a owl:DatatypeProperty ; rdfs:domain mov:Movie  ; rdfs:range xsd:int .
mov:imdbRating  a owl:DatatypeProperty ; rdfs:domain mov:Movie  ; rdfs:range xsd:double .
mov:plot        a owl:DatatypeProperty ; rdfs:domain mov:Movie  ; rdfs:range xsd:string .
mov:fullName    a owl:DatatypeProperty ; rdfs:domain mov:Person ; rdfs:range xsd:string .
mov:birthYear   a owl:DatatypeProperty ; rdfs:domain mov:Person ; rdfs:range xsd:int .
mov:nationality a owl:DatatypeProperty ; rdfs:domain mov:Person ; rdfs:range xsd:string .

mov:Movie rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty mov:hasDirector ;
    owl:someValuesFrom mov:Director
] .

mov:ClassicMovie a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            mov:Movie
            [ a owl:Restriction ;
              owl:onProperty mov:releaseYear ;
              owl:someValuesFrom [
                a rdfs:Datatype ;
                owl:onDatatype xsd:int ;
                owl:withRestrictions ( [ xsd:maxExclusive 1980 ] )
              ]
            ]
        )
    ] .

mov:AcclaimedMovie a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            mov:Movie
            [ a owl:Restriction ;
              owl:onProperty mov:wonAward ;
              owl:someValuesFrom mov:OscarAward ]
        )
    ] .

mov:MasterpieceMovie a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            mov:Movie
            [ a owl:Restriction ;
              owl:onProperty mov:imdbRating ;
              owl:someValuesFrom [
                a rdfs:Datatype ;
                owl:onDatatype xsd:double ;
                owl:withRestrictions ( [ xsd:minInclusive "8.5"^^xsd:double ] )
              ]
            ]
            [ a owl:Restriction ;
              owl:onProperty mov:wonAward ;
              owl:someValuesFrom mov:Award ]
        )
    ] .

mov:Genre_Action    a mov:Genre ; rdfs:label "Action" .
mov:Genre_Drama     a mov:Genre ; rdfs:label "Drama" .
mov:Genre_Comedy    a mov:Genre ; rdfs:label "Comedy" .
mov:Genre_Thriller  a mov:Genre ; rdfs:label "Thriller" .
mov:Genre_SciFi     a mov:Genre ; rdfs:label "Sci-Fi" .
mov:Genre_Horror    a mov:Genre ; rdfs:label "Horror" .
mov:Genre_Romance   a mov:Genre ; rdfs:label "Romance" .
mov:Genre_Animation a mov:Genre ; rdfs:label "Animation" .

