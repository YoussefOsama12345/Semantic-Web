# -----------------------------------------------------------------------------
# Sample SPARQL queries for the Semantic Movie Recommender
# Run them against the generated movies-inferred.owl file.
# -----------------------------------------------------------------------------

PREFIX mov:  <http://www.semanticweb.org/movies#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# --- Q1 : Search by movie title (partial, case-insensitive) ---
SELECT DISTINCT ?movie ?title WHERE {
  ?movie a mov:Movie ;
         mov:title ?title .
  FILTER(CONTAINS(LCASE(STR(?title)), LCASE("matrix")))
}

# --- Q2 : Search by actor ---
SELECT DISTINCT ?movie ?title WHERE {
  ?actor a mov:Actor ; mov:fullName ?name .
  ?movie mov:hasActor ?actor ; mov:title ?title .
  FILTER(CONTAINS(LCASE(STR(?name)), LCASE("DiCaprio")))
}

# --- Q3 : Search by director ---
SELECT DISTINCT ?movie ?title WHERE {
  ?d a mov:Director ; mov:fullName ?name .
  ?movie mov:hasDirector ?d ; mov:title ?title .
  FILTER(CONTAINS(LCASE(STR(?name)), LCASE("Nolan")))
}

# --- Q4 : Search by genre ---
SELECT DISTINCT ?movie ?title WHERE {
  ?movie a mov:Movie ;
         mov:belongsToGenre ?g ;
         mov:title ?title .
  ?g rdfs:label ?label .
  FILTER(CONTAINS(LCASE(STR(?label)), LCASE("thriller")))
}

# --- Q5 : Similar movies (uses SWRL-inferred similarTo) ---
SELECT DISTINCT ?similar ?title WHERE {
  ?src mov:title "Inception" .
  ?src mov:similarTo ?similar .
  ?similar mov:title ?title .
  FILTER(?src != ?similar)
}

# --- Q6 : Masterpiece movies (OWL + SWRL reasoning) ---
SELECT DISTINCT ?movie ?title WHERE {
  ?movie a mov:MasterpieceMovie ;
         mov:title ?title .
}

# --- Q7 : Acclaimed movies (defined class: Movie with Oscar) ---
SELECT DISTINCT ?movie ?title WHERE {
  ?movie a mov:AcclaimedMovie ;
         mov:title ?title .
}

# --- Q8 : Classic movies (before 1980) ---
SELECT DISTINCT ?movie ?title ?year WHERE {
  ?movie a mov:ClassicMovie ;
         mov:title ?title ;
         mov:releaseYear ?year .
}

# --- Q9 : Frequent collaborators (SWRL rule 4) ---
SELECT DISTINCT ?actor ?director WHERE {
  ?a mov:frequentCollaborator ?d .
  ?a mov:fullName ?actor .
  ?d mov:fullName ?director .
}
